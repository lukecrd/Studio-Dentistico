# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AQ.Ab8RN6LYYx5_WwJR6G_Rzp4mVRF48B4nCqmJ1jyf6WzvA8bywA"
GEMINI_MODEL=gemini-2.5-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_APP_URL: Optional public HTTPS origin used in 24h patient confirmation links.
PUBLIC_APP_URL=""

# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: Optional Meta WhatsApp Business Cloud API
# server-side credentials for automatic direct dispatch. If unset, reminders open via WhatsApp Web/App.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# TEXTBEE_API_KEY / TEXTBEE_DEVICE_ID / TEXTBEE_BASE_URL: TextBee SMS Gateway (https://api.textbee.dev/api/v1)
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""
TEXTBEE_BASE_URL="https://api.textbee.dev/api/v1"

# PORT: Server listen port (default 3000).
PORT="3000"
